    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "async_hooks": "^1.0.0",
        "better-sqlite3": "^12.9.0",
        "dotenv": "^16.6.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.4.1",
        "nanoid": "^5.1.11",
        "node-cron": "^4.2.1",
        "pino": "^10.3.1",
        "rate-limit-redis": "^4.3.1",
        "redis": "^5.12.1",
        "redis-cli": "^2.1.2",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "typeorm": "^0.3.28",
