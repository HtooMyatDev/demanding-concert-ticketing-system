{
    "name": "concert-ticketing-system",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "tsc",
        "start": "node dist/index.js",
        "dev": "tsx --watch src/index.ts",
        "typeorm": "typeorm-ts-node-esm",
        "migration:generate": "npm run typeorm -- migration:generate src/migrations/AddCategoryToTicket -d src/data-source.ts",
        "migration:run": "npm run typeorm -- migration:run -d src/data-source.ts",
        "migration:revert": "npm run typeorm -- migration:revert -d src/data-source.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "better-sqlite3": "^12.9.0",
        "express": "^5.2.1",
        "node-cron": "^4.2.1",
        "reflect-metadata": "^0.2.2",
        "sqlite3": "^5.1.7",
        "typeorm": "^0.3.28"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^25.6.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    }
}
